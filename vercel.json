{
  "rewrites": [
    { "source": "/api/geocode", "destination": "/api/tools?action=geocode" },
    { "source": "/api/send-csv", "destination": "/api/tools?action=send-csv" },
    { "source": "/api/rental-sheet", "destination": "/api/tools?action=rental-sheet" },
    { "source": "/portal", "destination": "/portal.html" },
    { "source": "/((?!api/|portal).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" },
        { "key": "Expires", "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    }
  ],
  "crons": [
    { "path": "/api/run-drips", "schedule": "0 14 * * *" }
  ]
}
